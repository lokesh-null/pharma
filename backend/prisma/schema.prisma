// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model — Unified authentication across all roles
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  fullName       String
  phone          String?   @unique
  dateOfBirth    String?
  gender         String?
  role           String    // PATIENT, DOCTOR, PHARMACIST, ADMIN
  profilePicture String?
  
  // Authentication Fields
  passwordHash       String?
  passwordCreated    Boolean   @default(false)
  lastPasswordChange DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil        DateTime?

  isVerified     Boolean   @default(false)
  isActive       Boolean   @default(true)
  lastLogin      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  otps            Otp[]
  sessions        Session[]
  auditLogs       AuditLog[]
  prescriptionsReceived Prescription[] @relation("PatientPrescriptions")
  prescriptionsIssued   Prescription[] @relation("IssuedPrescriptions")
  consentsGranted Consent[] @relation("GrantedConsents")
  consultationsAsDoctor Consultation[] @relation("DoctorConsultations")
  consultationsAsPatient Consultation[] @relation("PatientConsultations")
  notifications   Notification[]
  medicalHistoryAsPatient MedicalHistory[] @relation("PatientHistory")
  medicalHistoryAsDoctor  MedicalHistory[] @relation("DoctorHistory")
}

// OTP Model — Email OTP verification
model Otp {
  id           String   @id @default(uuid())
  userId       String
  otpCode      String   // SHA-256 hashed OTP
  expiresAt    DateTime
  isUsed       Boolean  @default(false)
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Session Model — Track active user sessions
model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  deviceInfo   String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Patient Model (Medical data — separate from auth)
model Patient {
  id               String   @id @default(uuid())
  aadhaarEncrypted Bytes    // AES-256-GCM encrypted Aadhaar
  aadhaarHash      String   @unique // SHA-256 hash for lookups
  nameEncrypted    Bytes    // AES-256-GCM encrypted name
  dobEncrypted     Bytes?   // AES-256-GCM encrypted date of birth
  phoneEncrypted   Bytes?   // AES-256-GCM encrypted phone
  phoneHash        String?  @unique // SHA-256 hash for lookups
  addressEncrypted Bytes?   // AES-256-GCM encrypted address
  consentGiven     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  consents      Consent[]
}

// Consent Management
model Consent {
  id        String   @id @default(uuid())
  patientId String
  grantedTo String
  scopes    String   // JSON string array of consent scopes
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation("GrantedConsents", fields: [grantedTo], references: [id])
}

// Audit Log Model
model AuditLog {
  id               String   @id @default(uuid())
  userId           String
  action           String
  resourceType     String
  resourceId       String?
  metadata         String?  // JSON string
  timestamp        DateTime @default(now())
  blockchainTxHash String?  // Optional blockchain transaction hash

  // Relations
  user User @relation(fields: [userId], references: [id])
}

// Medicine Model
model Medicine {
  id            String   @id @default(uuid())
  name          String
  manufacturer  String
  batchNumber   String   @unique
  blockchainId  String?  @unique // On-chain medicine ID
  verified      Boolean  @default(false)
  stock         Int      @default(0)
  price         Float    @default(0)
  category      String   @default("General")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  prescriptionMedicines PrescriptionMedicine[]
}

// Prescription Model
model Prescription {
  id          String    @id @default(uuid())
  patientId   String
  issuedBy    String    // User ID (DOCTOR or ADMIN)
  diagnosis   String    @default("")
  notes       String    @default("")
  qrToken     String?   // Secure QR token for this prescription
  dispensed   Boolean   @default(false)
  dispensedAt DateTime?
  dispensedBy String?   // User ID (PHARMACIST)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  patient   User                   @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  issuer    User                   @relation("IssuedPrescriptions", fields: [issuedBy], references: [id])
  medicines PrescriptionMedicine[]
}

// Junction table for Prescription-Medicine relationship
model PrescriptionMedicine {
  id             String @id @default(uuid())
  prescriptionId String
  medicineId     String
  quantity       Int
  dispensed      Int    @default(0)
  dosage         String

  // Relations
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id])

  @@unique([prescriptionId, medicineId])
}

// Consultation Model
model Consultation {
  id            String    @id @default(uuid())
  doctorId      String
  patientId     String
  symptoms      String    @default("[]") // JSON string of symptoms
  diagnosis     String    @default("")
  notes         String    @default("")
  followUpDate  DateTime?
  status        String    @default("Active") // Active, Completed
  priority      String    @default("Normal")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  doctor        User      @relation("DoctorConsultations", fields: [doctorId], references: [id])
  patient       User      @relation("PatientConsultations", fields: [patientId], references: [id])
}

// Notification Model
model Notification {
  id            String    @id @default(uuid())
  userId        String
  message       String
  type          String    @default("INFO")
  read          Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Medical History Model
model MedicalHistory {
  id            String    @id @default(uuid())
  patientId     String
  doctorId      String
  diagnosis     String
  notes         String
  date          DateTime  @default(now())

  patient       User      @relation("PatientHistory", fields: [patientId], references: [id])
  doctor        User      @relation("DoctorHistory", fields: [doctorId], references: [id])
}
