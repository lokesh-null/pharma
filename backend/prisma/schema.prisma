// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// User Model
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   // ADMIN, NURSE, STAFF, PHARMACY
  name         String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  auditLogs       AuditLog[]
  prescriptions   Prescription[]
  consentsGranted Consent[] @relation("GrantedConsents")
}

// Patient Model (Doctor-Free)
model Patient {
  id               String   @id @default(uuid())
  aadhaarEncrypted Bytes    // AES-256-GCM encrypted Aadhaar
  aadhaarHash      String   @unique // SHA-256 hash for lookups
  nameEncrypted    Bytes    // AES-256-GCM encrypted name
  dobEncrypted     Bytes?   // AES-256-GCM encrypted date of birth
  phoneEncrypted   Bytes?   // AES-256-GCM encrypted phone
  addressEncrypted Bytes?   // AES-256-GCM encrypted address
  consentGiven     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  prescriptions Prescription[]
  consents      Consent[]
}

// Consent Management
model Consent {
  id        String   @id @default(uuid())
  patientId String
  grantedTo String
  scopes    String   // JSON string array of consent scopes
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation("GrantedConsents", fields: [grantedTo], references: [id])
}

// Audit Log Model
model AuditLog {
  id               String   @id @default(uuid())
  userId           String
  action           String
  resourceType     String
  resourceId       String?
  metadata         String?  // JSON string
  timestamp        DateTime @default(now())
  blockchainTxHash String?  // Optional blockchain transaction hash

  // Relations
  user User @relation(fields: [userId], references: [id])
}

// Medicine Model
model Medicine {
  id            String   @id @default(uuid())
  name          String
  manufacturer  String
  batchNumber   String   @unique
  blockchainId  String?  @unique // On-chain medicine ID
  verified      Boolean  @default(false)
  stock         Int      @default(0)
  price         Float    @default(0)
  category      String   @default("General")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  prescriptionMedicines PrescriptionMedicine[]
}

// Prescription Model
model Prescription {
  id          String    @id @default(uuid())
  patientId   String
  issuedBy    String    // User ID (NURSE or ADMIN)
  diagnosis   String    @default("")
  notes       String    @default("")
  qrToken     String?   // Secure QR token for this prescription
  dispensed   Boolean   @default(false)
  dispensedAt DateTime?
  dispensedBy String?   // User ID (PHARMACY)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  patient   Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  issuer    User                   @relation(fields: [issuedBy], references: [id])
  medicines PrescriptionMedicine[]
}

// Junction table for Prescription-Medicine relationship
model PrescriptionMedicine {
  id             String @id @default(uuid())
  prescriptionId String
  medicineId     String
  quantity       Int
  dosage         String

  // Relations
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id])

  @@unique([prescriptionId, medicineId])
}
